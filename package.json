{
  "name": "endless-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "verify": "npm run validate && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.mts",
    "publish": "tsx scripts/publish.mts",
    "validate:offline": "tsx scripts/validate.mts --offline",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "rebalance": "tsx scripts/rebalance.mts",
    "dupe": "tsx scripts/dupe.mts",
    "dupe:refresh": "tsx scripts/dupe.mts --refresh",
    "dupe:score": "tsx scripts/dupe-score.mts",
    "probe": "tsx scripts/probe.mts",
    "review": "tsx scripts/review.mts",
    "review:serve": "tsx scripts/review.mts --serve",
    "bundle:bank": "tsx scripts/bundle-bank.mts",
    "assets:grain": "tsx scripts/grain.mts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "clsx": "2.1.1",
    "convex": "1.49.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "^0.0.67",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
